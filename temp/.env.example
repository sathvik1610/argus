# Select the active LLM provider: google | openai | anthropic | ollama
ARGUS_LLM_PROVIDER=google
ARGUS_LLM_MODEL=gemini-2.0-flash

GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Where Chroma persists its local index
ARGUS_CHROMA_DIR=.argus/chroma

# Logging
ARGUS_LOG_LEVEL=INFO
