# Copy this file to .env and fill in your key. Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# Optional overrides
# ARGUS_LLM_MODEL=gemini-2.5-flash
# ARGUS_EMBEDDING_MODEL=
# ARGUS_TOP_K=4

# Folders the API is allowed to read repositories from (separated by ';' on
# Windows and ':' on Linux/macOS). The API refuses every path if this is empty.
ARGUS_ALLOWED_REPO_DIRS=
